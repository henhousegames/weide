# local state and secrets (never commit)
private/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# build / export output
/build/
/dist/
/out/

# local agent worktrees
.claude/

# media written by `weide pull-approved` into the repo-root media/thumb dirs (the published copies live
# under site/, which stays committable: these patterns are anchored to the repository root)
/media/gen/
/thumb/*/gen/
